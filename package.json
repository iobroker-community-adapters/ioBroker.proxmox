{
  "name": "iobroker.proxmox",
  "version": "3.0.0",
  "description": "ioBroker Proxmox Adapter",
  "author": "MeisterTR <meistertr.smarthome@gmail.com>",
  "contributors": [
    "Matthias Kleine <info@haus-automatisierung.com>",
    "iobroker-community-adapters <iobroker-community-adapters@gmx.de>"
  ],
  "homepage": "https://github.com/iobroker-community-adapters/ioBroker.proxmox",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "Smart Home",
    "home automation",
    "Proxmox"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iobroker-community-adapters/ioBroker.proxmox"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "@iobroker/dm-utils": "^3.2.1",
    "axios": "^1.19.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/build-tools": "^3.0.3",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.1",
    "@iobroker/types": "^7.2.5",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "main": "build/main.js",
  "files": [
    "build/",
    "admin/",
    "widgets/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:widgets": "tsx tasks.ts",
    "check:widgets": "npm --prefix src-widgets run typecheck",
    "watch": "tsc -p tsconfig.build.json --watch",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint -c eslint.config.mjs",
    "test:package": "mocha test/packageFiles --exit",
    "test:unit": "node --test \"test/*.test.js\"",
    "test:integration": "mocha test/integrationAdapter --exit",
    "test": "npm run test:package",
    "translate": "translate-adapter -b admin/i18n/en.json",
    "release": "release-script",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "update-packages": "npx -y npm-check-updates --upgrade"
  },
  "bugs": {
    "url": "https://github.com/iobroker-community-adapters/ioBroker.proxmox/issues"
  },
  "readmeFilename": "README.md"
}
