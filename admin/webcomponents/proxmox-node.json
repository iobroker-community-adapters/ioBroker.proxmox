{
    "$schema": "https://raw.githubusercontent.com/ioBroker/web-components/main/schemas/manifest.json",
    "manifestVersion": 1,
    "tag": "iob-proxmox-node",
    "name": {
        "en": "Proxmox node",
        "de": "Proxmox-Node",
        "ru": "Узел Proxmox",
        "pt": "Nó Proxmox",
        "nl": "Proxmox-node",
        "fr": "Nœud Proxmox",
        "it": "Nodo Proxmox",
