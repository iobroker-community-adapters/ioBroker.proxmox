            "name": {
                "type": "text",
                "label": {
                    "en": "Title",
                    "de": "Titel",
                    "ru": "Заголовок",
                    "pt": "Título",
                    "nl": "Titel",
                    "fr": "Titre",
                    "it": "Titolo",
                    "es": "Título",
                    "pl": "Tytuł",
                    "uk": "Заголовок",
                    "zh-cn": "标题"
                },
                "help": {
                    "en": "If empty, the name of the node is shown",
                    "de": "Ist er leer, wird der Name des Nodes angezeigt",
                    "ru": "Если пусто, показывается имя узла",
                    "pt": "Se vazio, é mostrado o nome do nó",
                    "nl": "Indien leeg, wordt de naam van de node getoond",
                    "fr": "Si vide, le nom du nœud est affiché",
                    "it": "Se vuoto, viene mostrato il nome del nodo",
                    "es": "Si está vacío, se muestra el nombre del nodo",
