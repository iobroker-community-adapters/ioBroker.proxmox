    "settings": {
        "type": "panel",
        "items": {
            "node": {
                "type": "objectId",
                "types": "channel",
                "root": "proxmox",
                "label": {
                    "en": "Node",
                    "de": "Node",
                    "ru": "Узел",
                    "pt": "Nó",
                    "nl": "Node",
                    "fr": "Nœud",
                    "it": "Nodo",
                    "es": "Nodo",
                    "pl": "Węzeł",
                    "uk": "Вузол",
                    "zh-cn": "节点"
                },
                "help": {
                    "en": "The channel of the node, for example proxmox.0.node_pve",
                    "de": "Der Kanal des Nodes, zum Beispiel proxmox.0.node_pve",
                    "ru": "Канал узла, например proxmox.0.node_pve",
                    "pt": "O canal do nó, por exemplo proxmox.0.node_pve",
                    "nl": "Het kanaal van de node, bijvoorbeeld proxmox.0.node_pve",
                    "fr": "Le canal du nœud, par exemple proxmox.0.node_pve",
