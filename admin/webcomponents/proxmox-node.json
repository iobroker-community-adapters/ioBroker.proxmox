                "help": {
                    "en": "Needs the option \"Request available updates\" in the adapter",
                    "de": "Benötigt im Adapter die Option „Verfügbare Updates abfragen“",
                    "ru": "Требуется опция «Запрашивать доступные обновления» в адаптере",
                    "pt": "Requer a opção \"Solicitar atualizações disponíveis\" no adaptador",
                    "nl": "Vereist de optie \"Beschikbare updates opvragen\" in de adapter",
                    "fr": "Nécessite l'option « Demander les mises à jour disponibles » dans l'adaptateur",
                    "it": "Richiede l'opzione «Richiedi aggiornamenti disponibili» nell'adattatore",
                    "es": "Requiere la opción \"Solicitar actualizaciones disponibles\" en el adaptador",
                    "pl": "Wymaga opcji „Pobieraj dostępne aktualizacje” w adapterze",
                    "uk": "Потрібна опція «Запитувати доступні оновлення» в адаптері",
                    "zh-cn": "需要在适配器中启用“获取可用更新”选项"
                },
                "options": [
                    {
                        "value": "control",
                        "label": {
                            "en": "Show and refresh",
                            "de": "Anzeigen und aktualisieren",
                            "ru": "Показывать и обновлять",
                            "pt": "Mostrar e atualizar",
                            "nl": "Tonen en vernieuwen",
                            "fr": "Afficher et actualiser",
                            "it": "Mostra e aggiorna",
                            "es": "Mostrar y actualizar",
                            "pl": "Pokaż i odśwież",
                            "uk": "Показувати й оновлювати",
                            "zh-cn": "显示并刷新"
                        }
                    },
                    {
                        "value": "show",
                        "label": {
                            "en": "Show only",
                            "de": "Nur anzeigen",
                            "ru": "Только показывать",
                            "pt": "Apenas mostrar",
                            "nl": "Alleen tonen",
                            "fr": "Afficher seulement",
                            "it": "Solo mostra",
                            "es": "Solo mostrar",
                            "pl": "Tylko pokaż",
                            "uk": "Лише показувати",
                            "zh-cn": "仅显示"
                        }
                    },
                    {
                        "value": "hidden",
                        "label": {
                            "en": "Do not show",
                            "de": "Nicht anzeigen",
                            "ru": "Не показывать",
                            "pt": "Não mostrar",
                            "nl": "Niet tonen",
                            "fr": "Ne pas afficher",
                            "it": "Non mostrare",
                            "es": "No mostrar",
                            "pl": "Nie pokazuj",
                            "uk": "Не показувати",
                            "zh-cn": "不显示"
                        }
                    }
                ]
            }
